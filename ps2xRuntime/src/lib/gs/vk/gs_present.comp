#version 450
// PERF-PG: display conversion on the GPU. One thread per visible pixel reads the GS framebuffer (swizzled, in the 4 MB VRAM storage buffer) and writes
// plain RGBA8 rows (stride 640 pixels) into a small host-readable buffer, replacing the 4 MB page copy + CPU de-swizzle of the presenter.
// Mirrors GSCpuBackend::CopyFrameToHostRgba for CT32/CT24/CT16/CT16S followed by normalizePresentationAlpha (alpha = 255).
// Header of the output buffer: count of pixels with a non-zero RGB (the presenter's "is this frame black?" test).
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer Vram { uint vram[]; };
layout(std430, binding = 1) readonly buffer Tables { uint tbl[]; };
layout(std430, binding = 2) buffer Out { uint nonBlack; uint pad0; uint pad1; uint pad2; uint px[]; };

layout(push_constant) uniform PC
{
    uint base; // block address of the frame (fbp << 5 for display frames, fbp for a preferred source)
    uint fbw;  // frame width in 64-pixel units, already defaulted
    uint psm;  // 0 CT32, 1 CT24, 2 CT16, 10 CT16S
    uint x0;   // read origin (DBX)
    uint y0;   // read origin (DBY)
    uint w;
    uint h;
    uint pad;
} pc;

// page-table offsets (in u16 entries) inside the Tables buffer; same layout as gs_draw.frag
const uint T_C32 = 0u, T_C16 = 131072u, T_C16S = 262144u;

uint pixelAddr(uint tableOff, uint pageW, uint pageH, uint pixPerPage, uint base, uint bw, uint x, uint y)
{
    const uint basePage = base / 32u;
    const uint row = (y / pageH) * ((bw * 64u) / pageW);
    const uint col = x / pageW;
    const uint page = basePage + row + col;
    const uint idx = tableOff + (((base % 32u) * pageH + (y % pageH)) * pageW + (x % pageW));
    uint e = tbl[idx >> 1];
    e = ((idx & 1u) != 0u) ? (e >> 16) : (e & 0xFFFFu);
    return page * pixPerPage + e;
}

uint readColor(uint psm, uint base, uint bw, uint x, uint y)
{
    if (psm == 0u || psm == 1u)
    {
        const uint a = pixelAddr(T_C32, 64u, 32u, 2048u, base, bw, x, y);
        const uint v = vram[a & 0xFFFFFu];
        return psm == 1u ? (v & 0x00FFFFFFu) : v;
    }
    const uint off = (psm == 2u) ? T_C16 : T_C16S;
    const uint a = pixelAddr(off, 64u, 64u, 4096u, base, bw, x, y);
    const uint byteAddr = (a * 2u) & 0x3FFFFEu;
    return (vram[byteAddr >> 2] >> ((byteAddr & 2u) * 8u)) & 0xFFFFu;
}

shared uint wgCount;

void main()
{
    if (gl_LocalInvocationIndex == 0u)
        wgCount = 0u;
    barrier();
    const uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
    if (x < pc.w && y < pc.h)
    {
        const uint c = readColor(pc.psm, pc.base, pc.fbw, pc.x0 + x, pc.y0 + y);
        uint r, g, b;
        if (pc.psm <= 1u)
        {
            r = c & 255u;
            g = (c >> 8) & 255u;
            b = (c >> 16) & 255u;
        }
        else
        {
            const uint r5 = c & 31u, g5 = (c >> 5) & 31u, b5 = (c >> 10) & 31u;
            r = (r5 << 3) | (r5 >> 2);
            g = (g5 << 3) | (g5 >> 2);
            b = (b5 << 3) | (b5 >> 2);
        }
        px[y * 640u + x] = r | (g << 8) | (b << 16) | 0xFF000000u;
        if ((r | g | b) != 0u)
            atomicAdd(wgCount, 1u);
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u && wgCount != 0u)
        atomicAdd(nonBlack, wgCount);
}
